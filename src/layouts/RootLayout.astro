---
//types
interface Props {
  title?: string;
  description?: string;
}

//fonts
import "@fontsource-variable/inter";
import "@fontsource/poppins/100.css";
import "@fontsource/poppins/200.css";
import "@fontsource/poppins/300.css";
import "@fontsource/poppins/400.css";
import "@fontsource/poppins/500.css";
import "@fontsource/poppins/600.css";
import "@fontsource/poppins/700.css";
import "@fontsource/poppins/800.css";
import "@fontsource/poppins/900.css";
import "@fontsource-variable/ibm-plex-sans";
// Supports weights 100-900
import "@fontsource-variable/outfit";

import "../styles/global.css";
import "@styles/spruce-css.scss";

//scripts
import LocalScript from "@scripts/LocalScript.astro";
import ScrollAnimate from "@scripts/ScrollAnimate.astro";

//props
const {
  title = "Astro Introduction",
  description = "Simple website builder frameworks",
} = Astro.props;
---

<html lang="en" class="scroll-animation scroll-smooth">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <meta name="description" content={description} />
    <script async src="https://www.googletagmanager.com/gtm.js?id=GTM-T6L353CP"></script>
    <script>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
    </script>
  </head>
  <body>
    <!-- Skip to content link -->
    <a href="#main-content" class="btn btn--primary skip-link"
      >Skip to Content</a
    >

    <!-- page -->
    <slot />

    <!-- scripts -->
    <LocalScript />
    <ScrollAnimate />
  </body>
</html>
