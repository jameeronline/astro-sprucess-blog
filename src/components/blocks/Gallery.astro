---
interface GalleryImage {
  image: string;
  alt?: string;
  title?: string;
  url?: string;
}

interface Props {
  images?: GalleryImage[];
  isEven?: boolean;
}

const { images = [], isEven = false }: Props = Astro.props;
---

<div 
  class:list={[
    'gallery',
    { 'gallery--even': isEven },
    { 'gallery--uneven': !isEven }
  ]}
>
  {images && images.length > 0 ? (
    images.map((image, index) => (
      <figure class={`gallery-item gallery-item--${index + 1}`} data-scroll-animate>
        <a href={image.image} target="_blank" rel="noopener noreferrer">
          <img 
            src={image.image} 
            alt={image.alt || `Gallery image ${index + 1}`} 
            loading="lazy"
            decoding="async"
          />
        </a>
      </figure>
    ))
  ) : (
    <p class="gallery-empty">No images to display</p>
  )}
</div>