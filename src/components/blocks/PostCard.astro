---
//image component
import { Image } from "astro:assets";

//props
const { post, isHorizontal = false } = Astro.props;

//utils
import { slugify } from "@utils/index.js";

//props
const { title, thumbnail, thumbnailAlt, tags, author, lastUpdatedDate } =
  post.data;

const url = post.id;

//components
import PostAuthor from "./PostAuthor.astro";
---

{
  isHorizontal ? (
    <div class="post-card post-card--horizontal">
      <Image
      class="post-card__thumbnail"
      src={thumbnail}
      alt={thumbnailAlt}
      quality={90}
      loading="lazy"
      decoding="async"
      />
      <div class="post-card__body">
      <div class="post-card__meta">
        <div class="post-card__tags">
        {tags.map((tag: string) => (
          <a href={`/tag/${slugify(tag)}`}># {tag}</a>
        ))}
        </div>
        <time datetime={lastUpdatedDate}>{lastUpdatedDate}</time>
      </div>
      <h2 class="post-card__title">
        <a class="post-card__link" href={`/blog/${url}`}>
        {title}
        </a>
      </h2>
      <PostAuthor author={author} />
      </div>
    </div>
  ) : (
    <div class="post-card" data-scroll-animate>
      <Image
        class="post-card__thumbnail"
        src={thumbnail}
        alt={thumbnailAlt}
        quality={90}
        loading="lazy"
        decoding="async"
      />
      <div class="post-card__body">
        <div class="post-card__meta">
          <div class="post-card__tags">
            {tags.map((tag: string) => (
              <a href={`/tag/${slugify(tag)}`}># {tag}</a>
            ))}
          </div>
          <time datetime={lastUpdatedDate}>{lastUpdatedDate}</time>
        </div>
        <h2 class="post-card__title">
          <a class="post-card__link" href={`/blog/${url}`}>
            {title}
          </a>
        </h2>
        <PostAuthor author={author} />
      </div>
    </div>
  )
}
