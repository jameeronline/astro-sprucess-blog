---
//types
import type { FeatureItem } from "@/types/ui-types.ts";

//astro image
import { Image } from "astro:assets";

//images
import featureImg1 from "@/assets/why-you-should-choose-eleventy-as-your-static-site-generator.png";
import featureImg2 from "@/assets/the-different-types-of-css-frameworks.png";
import featureImg3 from "@/assets/8-helpful-sass-mixins-and-functions.png";
import featureImg4 from "@/assets/why-use-sass.png";

//icon
import { ArrowRight } from "@lucide/astro";

//features data
const features: FeatureItem[] = [
  {
    img: featureImg1,
    subtitle: "Two driven jocks help",
    title: "Better than water",
    description:
      "The quick, brown fox jumps over a lazy dog. DJs flock by when MTV ax quiz prog. Junk MTV quiz graced by fox whelps. Bawds jog, flick quartz, vex nymphs.",
    href: "#",
    btn: "Learn more",
    class: "feature--start",
  },
  {
    img: featureImg2,
    subtitle: "A very bad quack might",
    title: "Fresh as always",
    description:
      'A wizard’s job is to vex chumps quickly in fog. Watch "Jeopardy!", Alex Trebek\'s fun TV quiz game. Woven silk pyjamas exchanged for blue quartz. Brawny gods just.',
    href: "#",
    btn: "Learn more",
    class: "feature--end",
  },
  {
    img: featureImg3,
    subtitle: "Quick brown foxes",
    title: "Speed and Agility",
    description:
      "Quick brown foxes leap over lazy dogs with ease. Their agility and speed make them stand out in any crowd.",
    href: "#",
    btn: "Discover",
    class: "feature--start",
  },
  {
    img: featureImg4,
    subtitle: "Wizards at work",
    title: "Magic Touch",
    description:
      "Wizards conjure solutions out of thin air, making complex problems disappear with a wave of their wand.",
    href: "#",
    btn: "Explore",
    class: "feature--end",
  }
];
---

<div class="l-feature">
  <div class="l-feature__inner" data-scroll-animate>
    {
      features.map((feature) => (
        <div class={`feature ${feature.class}`} data-scroll-animate>
          <Image
            src={feature.img}
            alt={feature.title}
            class="feature__thumbnail"
            quality={90}
            loading="lazy"
            decoding="async"
          />
          <div class="feature__caption">
            <p class="feature__subtitle">{feature.subtitle}</p>
            <h2 class="feature__title">{feature.title}</h2>
            <p>{feature.description}</p>
            <a class="btn btn--primary feature__btn" href={feature.href}>
              {feature.btn}
              <ArrowRight class="btn__icon" />
            </a>
          </div>
        </div>
      ))
    }
  </div>
</div>
