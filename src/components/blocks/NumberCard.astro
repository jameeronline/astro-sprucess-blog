---
//types
import type { NumberCard } from "@/types/ui-types.ts";
import { Briefcase, Users, Trophy, Coffee } from "@lucide/astro";

const stats: NumberCard[] = [
  { target: 325, label: "Projects Completed", icon: Briefcase },
  { target: 150, label: "Happy Clients", icon: Users },
  { target: 25, label: "Awards Won", icon: Trophy },
  { target: 100, label: "Cups of Coffee Per Day", icon: Coffee },
];
---

<section class="section" data-scroll-animate>
  <h2 class="section-title">Our Achievements</h2>
  <div class="number-card__wrapper">
    {
      stats.map((stat) => (
        <div class="number-card" data-scroll-animate>
          {stat.icon && <stat.icon class="number-card__icon" size={24} />}
          <p class="number-card__data">
            <span data-action="countup" data-target={stat.target}>
              0
            </span>
            +
          </p>
          <p class="number-card__caption">{stat.label}</p>
        </div>
      ))
    }
  </div>
</section>

