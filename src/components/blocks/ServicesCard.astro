---
//types
import type { ServicesCard } from "@/types/ui-types.ts";

//data
const services: ServicesCard[] = [
  {
    title: "Custom Web Development",
    description:
      "Build fast, scalable websites tailored to your goals. We craft maintainable code, modular components, and responsive layouts that grow with your business.",
    link: "#",
    linkText: "Explore custom builds",
  },
  {
    title: "E‑commerce Development",
    description:
      "Launch high-converting online stores with secure checkout, inventory management, and payment integrations optimized for conversion and performance.",
    link: "#",
    linkText: "See e‑commerce solutions",
  },
  {
    title: "UI / UX Design",
    description:
      "Design intuitive interfaces focused on user needs. We deliver wireframe, prototypes, and polished visuals that drive engagement and trust.",
    link: "#",
    linkText: "View design services",
  },
  {
    title: "Performance & SEO Optimization",
    description:
      "Improve load times and search visibility with front-end performance tuning, image optimization, and on-page SEO best practices.",
    link: "#",
    linkText: "Improve performance",
  },
  {
    title: "Headless CMS & Integrations",
    description:
      "Connect content platforms, APIs, and third‑party tools for flexible, future-proof architectures that streamline content workflows.",
    link: "#",
    linkText: "Learn about integrations",
  },
  {
    title: "Maintenance & Support",
    description:
      "Keep your site secure and up to date with monitoring, updates, backups, and fast incident response to minimize downtime.",
    link: "#",
    linkText: "Get support plans",
  },
];
---

<section class="section">
  <h2 class="section-title">Our Services</h2>
  <div class="info-card__wrapper" data-scroll-animate>
    {
      services.map((service) => (
        <div class="info-card">
          <div class="info-card__caption">
            <h2 class="info-card__title">{service.title}</h2>
            <p>{service.description}</p>
          </div>
          <a class="info-card__link" href={service.link}>
            {service.linkText}
          </a>
        </div>
      ))
    }
  </div>
</section>
