---
//components
import Container from "@/components/ui/Container.astro";
import ThemeSwitcher from "@/components/ui/ThemeSwitcher.astro";
import LangSwitcher from "@components/blocks/LangSwitcher.astro";
import SiteNavigation from "@/components/blocks/SiteNavigation.astro";
---

<header class="site-header">
  <div class="container">
    <div class="site-header__inner">
      <div class="site-header__column">
        <a class="site-header__logo" href="/">
          <img src="/img/cone-logo.svg" alt="Cone" width="48" height="48" />
        </a>
        <SiteNavigation links={[
          { href: '/services', label: 'Services' },
          { href: '/products', label: 'Products' },
          { href: '/blog', label: 'Blog' },
          { href: '/about', label: 'About' },
          { href: '/contact', label: 'Contact' },
        ]} />
      </div>
      <div class="site-header__actions">
        <a class="site-header__email" href="mailto:contact@uidev.com"
          >contact@uidev.com</a
        >
        <ThemeSwitcher />
        <LangSwitcher />
        <a class="search-link" href="/search">
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" stroke="currentColor" fill="currentColor"><path d="M18.031 16.6168L22.3137 20.8995L20.8995 22.3137L16.6168 18.031C15.0769 19.263 13.124 20 11 20C6.032 20 2 15.968 2 11C2 6.032 6.032 2 11 2C15.968 2 20 6.032 20 11C20 13.124 19.263 15.0769 18.031 16.6168ZM16.0247 15.8748C17.2475 14.6146 18 12.8956 18 11C18 7.1325 14.8675 4 11 4C7.1325 4 4 7.1325 4 11C4 14.8675 7.1325 18 11 18C12.8956 18 14.6146 17.2475 15.8748 16.0247L16.0247 15.8748Z"></path></svg>
        </a>
        <a class="btn btn--primary" href="auth/register">
          <svg
            class="btn__icon"
            aria-hidden="true"
            fill="none"
            focusable="false"
            height="24"
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="3"
            stroke="currentColor"
            viewBox="0 0 24 24"
            width="24"
            xmlns="http://www.w3.org/2000/svg"
          >
            <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path>
            <circle cx="12" cy="7" r="4"></circle>
          </svg>
          Log in
        </a>
      </div>
    </div>
  </div>
</header>