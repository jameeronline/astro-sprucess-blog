---
//astro collections
import { getCollection, getEntry } from 'astro:content';

//layout
import BaseLayout from "@layouts/BaseLayout.astro";

//components
import PageHeading from "@components/blocks/PageHeading.astro";
import PostList from "@components/blocks/PostList.astro";

//fetch posts collection
const postsCollection = await getCollection("posts");
---

<BaseLayout title="Blog" description="Latest blogs">
  <PageHeading title="Latest Articles" />
  <PostList posts={postsCollection} />
</BaseLayout>
