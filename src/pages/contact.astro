---
//import layout
import BaseLayout from "@layouts/BaseLayout.astro";
import PageHeading from "@components/blocks/PageHeading.astro";

//components
import ContactCard from "@components/blocks/ContactCard.astro";
import ContactForm from "@components/blocks/ContactForm.astro";

//icons
import { MapPin, Mail, Phone } from "@lucide/astro";
---

<BaseLayout>
  <!-- <PageHeading title="Contact" /> -->
  <header class="page-header">
    <h1 class="page-header__title">Contact Us</h1>
    <p class="page-header__desc">
      Have a project in mind? We'd love to hear from you. Send us a message and
      we'll respond as soon as possible.
    </p>
  </header>
  <section class="contact-grid">
    <ContactForm />

    <div class="map-column">
      <div class="contact-cards">
        <ContactCard
          Icon={Mail}
          title="Email Us"
          description="Send us an email."
          info="contact@sprucecss.com"
        />
        <ContactCard
          Icon={MapPin}
          title="Our Main Office"
          description="Come say hello at our office."
          info="1234 Spruce St, San Francisco, CA 94111"
        />
        <ContactCard
          Icon={Phone}
          title="Call Us"
          description="Call us at our main office."
          info="(123) 456-7890"
        />
      </div>
      <!-- <div id="map"></div> -->
      <!-- <ul
        id="locations"
        class="locations-list"
        aria-label="Office locations list"
      >
      </ul> -->
    </div>
  </section>
</BaseLayout>
