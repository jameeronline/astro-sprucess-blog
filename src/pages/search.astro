---
//astro imports
import { getCollection } from "astro:content";

//import layout
import BaseLayout from "@layouts/BaseLayout.astro";
import PageHeading from "@components/blocks/PageHeading.astro";

//fetch users collection at build time
const allUsers = await getCollection("users");
---

<BaseLayout title="Search" description="Search our users">
  <PageHeading title="Search" />

  <div class="container">
    <form action="/search" method="GET" class="search-form">
      <input
        type="text"
        name="q"
        placeholder="Search users by name, email, company..."
        class="form-control form-control--lg"
        required
        value=""
      />
      <div class="search-form__actions">
        <button type="submit" class="btn btn--primary btn--lg">Search</button>
        <a href="/search" class="" role="button" aria-label="Reset search"
          >Reset</a
        >
      </div>
    </form>

    <!-- Results are filtered client-side so the page can stay static -->
    <div class="search-results" data-search-results hidden>
      <h2>
        Search Results (<span data-result-count>0</span> found)
      </h2>

      <div class="user-grid">
        {
          allUsers.map((user) => {
            const data = user.data;
            const searchableText = [
              data.name,
              data.email,
              data.username,
              data.company?.name,
              data.address?.city,
            ]
              .filter(Boolean)
              .join(" ")
              .toLowerCase();

            return (
              <div class="user-card" data-search={searchableText}>
                <h3>{data.name}</h3>
                <p>
                  <strong>Email:</strong> {data.email}
                </p>
                <p>
                  <strong>Username:</strong> {data.username}
                </p>
                {data.company && (
                  <p>
                    <strong>Company:</strong> {data.company.name}
                  </p>
                )}
                {data.address && (
                  <p>
                    <strong>City:</strong> {data.address.city}
                  </p>
                )}
              </div>
            );
          })
        }
      </div>
    </div>

    <p data-no-results hidden>
      No users found matching "<span data-query></span>"
    </p>
  </div>
</BaseLayout>

<script>
  const params = new URLSearchParams(window.location.search);
  const query = (params.get("q") ?? "").trim();
  const input = document.querySelector<HTMLInputElement>('input[name="q"]');
  const results = document.querySelector<HTMLElement>("[data-search-results]");
  const cards = Array.from(
    document.querySelectorAll<HTMLElement>("[data-search]"),
  );
  const count = document.querySelector<HTMLElement>("[data-result-count]");
  const noResults = document.querySelector<HTMLElement>("[data-no-results]");
  const queryLabel = document.querySelector<HTMLElement>("[data-query]");

  if (input) input.value = query;

  if (query) {
    const needle = query.toLowerCase();
    let matches = 0;

    cards.forEach((card) => {
      const match = card.dataset.search?.includes(needle) ?? false;
      card.hidden = !match;
      if (match) matches += 1;
    });

    if (results) results.hidden = false;
    if (count) count.textContent = String(matches);
    if (noResults) noResults.hidden = matches !== 0;
    if (queryLabel) queryLabel.textContent = query;
  }
</script>

<style>
  .user-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
    gap: 1rem;
    margin: 2rem 0;
  }

  .user-card {
    padding: 1rem;
    border: 1px solid #ddd;
    border-radius: 8px;
    background: white;
  }

  .user-card h3 {
    margin-top: 0;
    color: #333;
  }

  .debug-info {
    font-family: monospace;
    font-size: 0.9rem;
  }
</style>
