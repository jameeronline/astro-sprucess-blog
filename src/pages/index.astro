---
//astro imports
import { getCollection } from "astro:content";

//import layout
import BaseLayout from "@layouts/BaseLayout.astro";

//components
import CTA from "@components/blocks/CTA.astro";
import NumberCard from "@components/blocks/NumberCard.astro";
import ServicesCard from "@/components/blocks/ServicesCard.astro";
import Hero from "@/components/blocks/Hero.astro";
import RecentPosts from "@/components/blocks/RecentPosts.astro";

//recent posts
const recentPosts = (await getCollection("posts"))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 3);

if (!recentPosts) {
  throw new Error("No posts found");
}
---

<BaseLayout>
  <Hero />
  <!-- <Loader />
  <State />
  <PaymentCard /> -->
  <ServicesCard />
  <NumberCard />
  <CTA />
  <RecentPosts posts={recentPosts} />
</BaseLayout>

<script>
  document.addEventListener("DOMContentLoaded", function () {});
</script>
